{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "./build_web.sh",
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/pythons.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
